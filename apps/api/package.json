{
  "name": "@absolute-ice-cream/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=../../packages/database/prisma/schema.postgresql.prisma && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --ext .ts",
    "postinstall": "prisma generate --schema=../../packages/database/prisma/schema.postgresql.prisma",
    "start": "node dist/server.js",
    "test": "node --test --import tsx src/tests/inventory.test.ts src/tests/procurement.test.ts src/tests/branch-operations.test.ts src/tests/reports-jobs.test.ts src/tests/production.test.ts src/tests/sales.test.ts src/tests/finance.test.ts src/tests/hr.test.ts src/tests/maintenance.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@absolute-ice-cream/database": "*",
    "@absolute-ice-cream/shared": "*",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.50.5",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.7",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.15.0",
    "prisma": "^6.19.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.21",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
