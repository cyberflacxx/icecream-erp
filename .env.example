# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://api.robokorda.duckdns.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY

# App URLs
ABSOLUTE_ERP_BASE_URL=https://www.absolute-erp.com
NEXT_PUBLIC_APP_URL=https://www.absolute-erp.com
NEXT_PUBLIC_SITE_URL=https://www.absolute-erp.com
APP_URL=https://www.absolute-erp.com
BASE_URL=https://www.absolute-erp.com

# Database schema
SUPABASE_DB_SCHEMA=icecream_erp
POSTGREST_SCHEMA=icecream_erp
NEXT_PUBLIC_SUPABASE_SCHEMA=icecream_erp

# Admin and registration keys
SYSTEM_ADMIN_DELETE_KEY=PASTE_SYSTEM_ADMIN_DELETE_KEY
ADMIN_DELETE_KEY=PASTE_ADMIN_DELETE_KEY
ADMIN_KEY=PASTE_ADMIN_KEY
ADMIN_REGISTRATION_KEY=PASTE_ADMIN_REGISTRATION_KEY
IMPERSONATE_KEY=PASTE_IMPERSONATE_KEY
PASSWORD_RESET_SECRET=PASTE_PASSWORD_RESET_SECRET
REGISTRATION_OTP_SECRET=PASTE_REGISTRATION_OTP_SECRET

# Email and notifications
RESEND_API_KEY=PASTE_RESEND_API_KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_WITHOUT_SPACES
SMTP_FROM=Absolute ERP <you@example.com>
EMAIL_FROM=Absolute ERP <you@example.com>
MAIL_FROM=Absolute ERP <you@example.com>

# Legacy mail aliases kept for compatibility
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=PASTE_GMAIL_APP_PASSWORD_WITHOUT_SPACES

# App identity
NEXT_PUBLIC_COMPANY_NAME=Absolute Ice Cream
NEXT_PUBLIC_APP_NAME=Absolute Ice Cream ERP
NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com
EMAIL_APP_NAME=Absolute IceCream

# Optional runtime tuning
AUTH_LOGIN_TIMEOUT_MS=12000
NEXT_PUBLIC_SUPABASE_REQUEST_TIMEOUT_MS=15000
SUPABASE_REQUEST_TIMEOUT_MS=15000
NEXT_IGNORE_INCORRECT_LOCKFILE=1
NEXT_TELEMETRY_DISABLED=1

# Optional integrations
OPENAI_API_KEY=PASTE_OPENAI_API_KEY
API_URL=https://api.pushover.net/1/messages.json
USER_KEY=PASTE_PUSHOVER_USER_KEY
APP_TOKEN=PASTE_PUSHOVER_APP_TOKEN

# Optional smoke and verification
SMOKE_BASE_URL=https://www.absolute-erp.com
SMOKE_ADMIN_WORK_ID=
SMOKE_BRANCH_WORK_ID=
ABSOLUTE_TEST_SUPER_ADMIN_WORK_ID=
ABSOLUTE_TEST_BRANCH_MANAGER_WORK_ID=
ABSOLUTE_TEST_ACCOUNTANT_WORK_ID=
ABSOLUTE_TEST_PASSWORD=
FRONTEND_SMOKE_TIMEOUT_MS=20000
VERIFY_TIMEOUT_MS=20000
