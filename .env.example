# Database
# MySQL local example:
# DATABASE_URL=mysql://aqi_user:AqiLocal@2026!@127.0.0.1:3306/absolute_ice_cream_erp
#
# Supabase Postgres example:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=
DB_PROVIDER=mysql

# Auth
JWT_SECRET=your-very-long-random-secret-here
JWT_EXPIRY=8h
ADMIN_KEY=AQI-ADMIN-2026

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_APP_NAME="Absolute Ice Cream ERP"
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_PASSWORD=
EMAIL_FROM="Absolute Ice Cream ERP <noreply@absoluteicecream.co.zw>"

# API / Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=4000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
